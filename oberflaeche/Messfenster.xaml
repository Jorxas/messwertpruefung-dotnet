<Window x:Class="Messansicht.Messfenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messwerte prüfen — studentische Übung" Language="de-DE"
        Width="1000" Height="600" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" FontSize="14" Background="#F5F7FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Messwerte prüfen" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,14" />
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button x:Name="Dateiauswahl" Content="_CSV-Datei auswählen …" Click="DateiAuswaehlen"
                    Padding="12,8" Margin="0,0,14,0" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock Text="Datei" FontWeight="SemiBold" />
                <TextBlock x:Name="Dateianzeige" Text="Noch keine Datei ausgewählt."
                           TextWrapping="Wrap" AutomationProperties.Name="Ausgewählte Datei" />
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="Regelanzeige" Grid.Row="2" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="CSV: messung_id,wert,einheit · Dezimalpunkt · Einheit mm" />
        <DataGrid x:Name="Ergebnistabelle" Grid.Row="3" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#EDF2F7"
                  AutomationProperties.Name="Messwerte und Prüfergebnisse">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Zeile" Binding="{Binding Zeile}" Width="55" />
                <DataGridTextColumn Header="Kennung" Binding="{Binding Kennung}" Width="85" />
                <DataGridTextColumn Header="Wert" Binding="{Binding Wert}" Width="85" />
                <DataGridTextColumn Header="Einheit" Binding="{Binding Einheit}" Width="65" />
                <DataGridTextColumn Header="Ergebnis" Binding="{Binding Ergebnis}" Width="*" MinWidth="300">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="Margin" Value="5,7" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="Meldungsanzeige" Grid.Row="4" Text="Bitte eine CSV-Datei auswählen."
                   TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,12"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Grid.Row="5" TextWrapping="Wrap" Foreground="#465467"
                   Text="Studentische Übung mit synthetischen Daten. Keine industrielle oder medizinische Zertifizierung." />
    </Grid>
</Window>
